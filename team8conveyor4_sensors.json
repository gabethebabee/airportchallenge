  {
    "id": "team8-c4-speed",
    "type": "function",
    "z": "team8-c4-sensors-tab",
    "name": "Encoder to cm/s",
    "func": "// Read-only calculation: no PLC output is written.\nconst now=Date.now(), raw=msg.payload;\nconst count=Number(raw), prev=context.get('previous');\nlet speed=null;\nif (raw!==null && raw!=='' && typeof raw!=='boolean' && Number.isFinite(count) && count>=0) {\n  if (prev && now>prev.at && now-prev.at<=3000 && count>=prev.count)\n    speed=(count-prev.count)/(700*4)*(10.5*3.14)/((now-prev.at)/1000);\n  context.set('previous',{count,at:now});\n} else context.set('previous',null);\nmsg.payload=JSON.stringify(speed);msg.retain=false;return msg;",
    "initialize": "// Clear pre-deploy counter history.\ncontext.set('previous',null);",
    "outputs": 1,
    "x": 490,
    "y": 100,
    "wires": [
      [
        "team8-c4-publish-speed"
      ]
    ]
  },
  {
    "id": "team8-c4-publish-speed",
    "type": "mqtt out",
    "z": "team8-c4-sensors-tab",
    "name": "Conveyor4/get_belt_speed",
    "topic": "Conveyor4/get_belt_speed",
    "qos": "0",
    "retain": "false",
    "broker": "team8-c4-sensors-broker",
    "x": 830,
    "y": 100,
    "wires": []
  },
  {
    "id": "team8-c4-volts",
    "type": "function",
    "z": "team8-c4-sensors-tab",
    "name": "Voltage in V",
    "func": "// Read actual channel 7 voltage; never relabel it as amperage.\nconst raw=msg.payload, value=Number(raw);\nmsg.payload=JSON.stringify(raw!==null && raw!=='' && typeof raw!=='boolean' && Number.isFinite(value) && value>=0 ? value : null);\nmsg.retain=false;return msg;",
    "initialize": "// Clear pre-deploy counter history.\ncontext.set('previous',null);",
    "outputs": 1,
    "x": 490,
    "y": 240,
    "wires": [
      [
        "team8-c4-publish-volts"
      ]
    ]
  },
  {
    "id": "team8-c4-publish-volts",
    "type": "mqtt out",
